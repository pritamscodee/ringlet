# ---------------------------------------------------------------------------
# Next.js (.env.local)
# ---------------------------------------------------------------------------
# Written by `bunx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Speech: https://console.deepgram.com (needs a key with Member scope or higher to mint browser tokens)
DEEPGRAM_API_KEY=

# Agent LLM, used by Mastra's "anthropic/..." model strings
ANTHROPIC_API_KEY=
# Optional override for the default model
# RINGLET_DEFAULT_MODEL=anthropic/claude-haiku-5-5

# Signs per-call tickets. Any long random string: `openssl rand -base64 32`
RINGLET_SESSION_SECRET=

# Sentry (optional in development)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Convex deployment env: set with `bunx convex env set NAME value`
# (not read from this file)
# ---------------------------------------------------------------------------
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=...        (Convex Auth; `bunx @convex-dev/auth` generates these)
# JWKS=...

# Razorpay (subscriptions). Used by Convex, not Next.js: after filling these in,
# copy them to the Convex deployment with `bunx convex env set NAME value`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
