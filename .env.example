# ---------------------------------------------------------------------------
# Next.js (.env.local)
# ---------------------------------------------------------------------------

# Neon Postgres. DATABASE_URL is the pooled endpoint (host contains -pooler) and
# is what the app uses. DIRECT_URL is the same database without -pooler, used
# by Prisma for migrations.
DATABASE_URL=
DIRECT_URL=

# Better Auth. Secret: `openssl rand -base64 32`. URL: the app's origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Speech: https://console.deepgram.com (needs a key with Member scope or higher to mint browser tokens)
DEEPGRAM_API_KEY=

# Agent LLM, used by Mastra's "anthropic/..." model strings
ANTHROPIC_API_KEY=
# Optional override for the default model
# RINGLET_DEFAULT_MODEL=anthropic/claude-haiku-5-5

# Signs per-call tickets. Any long random string: `openssl rand -base64 32`
RINGLET_SESSION_SECRET=

# Call recordings (optional). An S3 bucket name; AWS credentials come from the
# standard AWS chain. Leave empty and recording is turned off.
RECORDINGS_BUCKET=

# Public demo: set to an agent id to turn the landing-page hero into a
# real, callable agent instead of the scripted walkthrough. Leave empty and
# the page falls back to the animation.
NEXT_PUBLIC_DEMO_AGENT_ID=

# Sentry (optional in development)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
