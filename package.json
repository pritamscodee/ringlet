{
  "name": "ringlet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n convex,next \"bun run dev:convex\" \"bun run dev:next\"",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "postinstall": "node scripts/copy-vad-assets.mjs",
    "deploy:convex": "convex deploy",
    "deploy": "sst deploy --stage production",
    "test": "bun test tests"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/react-query": "^0.1.0",
    "@deepgram/sdk": "^5.18.0",
    "@mastra/core": "^1.82.0",
    "@ricky0123/vad-web": "^0.0.31",
    "@sentry/nextjs": "^11.11.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "onnxruntime-web": "^1.31.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "server-only": "^0.0.1",
    "sst": "^4.17.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.6",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
